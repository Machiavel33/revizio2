# ============================================================
# Revizio — variables d'environnement (exemple)
# Copier vers .env et adapter. NE JAMAIS committer .env.
# ============================================================

# --- App ---
APP_NAME=Revizio
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# URL publique du backend (utilisée pour CORS + liens)
BACKEND_URL=http://localhost:8000
# Origines autorisées CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:1420

# --- Sécurité / JWT ---
# Générer avec: openssl rand -hex 32
SECRET_KEY=change_me_dev_only_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Clé maître pour chiffrer les clés API BYOK (AES-256-GCM).
# Générer avec: openssl rand -base64 32  (doit faire 32 octets décodés)
BYOK_ENCRYPTION_KEY=change_me_dev_only_openssl_rand_base64_32

# --- PostgreSQL ---
POSTGRES_USER=revizio
POSTGRES_PASSWORD=revizio_dev
POSTGRES_DB=revizio
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://revizio:revizio_dev@localhost:5432/revizio

# --- Redis / Celery ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MinIO / S3 ---
MINIO_ROOT_USER=revizio
MINIO_ROOT_PASSWORD=revizio_dev_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=revizio-audio
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=revizio
S3_SECRET_KEY=revizio_dev_secret
S3_REGION=us-east-1

# --- IA (valeurs par défaut, surchargées par les clés BYOK utilisateur) ---
# Fournisseur de transcription par défaut: openai | deepgram
DEFAULT_TRANSCRIBE_PROVIDER=openai
# Modèle de génération de fiche par défaut: anthropic | openai
DEFAULT_SHEET_PROVIDER=anthropic
