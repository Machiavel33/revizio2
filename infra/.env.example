# ============================================================
# Revizio — variables d'environnement pour docker compose
# Copier vers .env et adapter. NE JAMAIS committer .env.
# ============================================================

# --- App ---
APP_ENV=production
DEBUG=false
API_PORT=8000
WEB_PORT=8080
# Origines autorisées CORS (URL du front web)
CORS_ORIGINS=http://localhost:8080

# --- Sécurité (OBLIGATOIRES en prod) ---
# Générer: openssl rand -hex 32
SECRET_KEY=change_me_openssl_rand_hex_32
# Générer: openssl rand -base64 32  (32 octets décodés)
BYOK_ENCRYPTION_KEY=change_me_openssl_rand_base64_32

# --- PostgreSQL ---
POSTGRES_USER=revizio
POSTGRES_PASSWORD=revizio_dev
POSTGRES_DB=revizio
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- MinIO / S3 ---
MINIO_ROOT_USER=revizio
MINIO_ROOT_PASSWORD=revizio_dev_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=revizio-audio
